{
  "name": "hisabche",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1",
    "@supabase/supabase-js": "^2.106.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.39.0",
    "nextjs-google-analytics": "^2.3.7",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.374.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "socks-proxy-agent": "^10.0.0",
    "tailwind-merge": "^3.5.0",
    "undici": "^8.2.0"
  }
}
