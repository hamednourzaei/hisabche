# ==============================================================================
# Hisabche — Safe Environment Variable Template (NO SECRETS)
# Copy to `.env.local` (web/dev) or configure in deployment secret manager.
# Never commit actual `.env`, `.env.local`, `.env.production`, or `.env.staging`.
# ==============================================================================

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_REPLICA_URL=
DATABASE_URL=

# Auth & Writer Fencing (Required >= 16 chars in production)
JWT_SECRET=
WRITER_FENCING_SECRET=
WRITER_CLUSTER_KEY=primary-cluster
PRIMARY_WRITER_ID=primary-master-01
FENCING_ALLOW_LOCAL_ONLY=false

# Infrastructure Admin / Nginx Control Plane
NGINX_RELOAD_WEBHOOK_URL=
NGINX_RELOAD_WEBHOOK_SECRET=

# Object Storage
STORAGE_PROVIDER=supabase
STORAGE_LOCAL_ROOT=./storage
STORAGE_SIGNING_SECRET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Web / Client Public Config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENCRYPTION_KEY=
