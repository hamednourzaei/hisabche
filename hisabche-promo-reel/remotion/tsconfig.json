{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@promo/*": ["../src/*"]
    }
  },
  "include": [
    "src",
    "../../src/reels",
    "../../src/ReelFrame.tsx",
    "../../src/engine",
    "../../src/data",
    "../../src/scenes"
  ],
  "exclude": ["../../src/__tests__"]
}
