{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm type-check)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm format:check)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx jest:*)",
      "Bash(npx next build:*)",
      "Bash(npx electron-vite build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npx eas-cli:*)",
      "Bash(npx electron-builder:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/**/.env)",
      "Read(./apps/**/.env.*)",
      "Bash(psql:*)",
      "Bash(npx drizzle-kit push:*)",
      "Bash(npx supabase db:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)"
    ]
  }
}
