# ============================================
# Hisabche - Environment Variables
# Copy to .env and fill in real values
# ============================================

# ---------- App ----------
NODE_ENV=development
APP_NAME=hisabche
APP_URL=http://localhost:3000

# ---------- Supabase ----------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# NOTE: the backend reads SUPABASE_SERVICE_KEY (see backend/src/db.ts). This
# file used to document it as SUPABASE_SERVICE_ROLE_KEY, so a .env copied from
# here left the server refusing to start with "SUPABASE_SERVICE_KEY is
# required". Must be the service_role key, not the anon key — db.ts logs the
# JWT role claim on boot and warns if it sees anon, because RLS would then
# block every backend query.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ---------- Arcjet ----------
ARCJET_KEY=your-arcjet-key-here
ARCJET_ENV=development

# ---------- Sentry ----------
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/1234567

# ---------- PostHog ----------
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------- Database ----------
DATABASE_URL=postgresql://user:password@localhost:5432/hisabche