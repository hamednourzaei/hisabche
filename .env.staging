# ─── App ───
NODE_ENV=staging
NEXT_PUBLIC_APP_NAME=hisabche-staging
NEXT_PUBLIC_API_URL=https://staging-api.hisabche.com/api
NEXT_PUBLIC_APP_URL=https://staging.hisabche.com

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging-key

# ─── PostHog ───
NEXT_PUBLIC_POSTHOG_KEY=phc_staging_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry ───
NEXT_PUBLIC_SENTRY_DSN=https://staging-sentry.ingest.sentry.io/xxx
SENTRY_ORG=hisabche
SENTRY_PROJECT=web-staging

# ─── Arcjet ───
ARCJET_KEY=staging_key
ARCJET_ENV=staging

# ─── Database ───
DATABASE_URL=postgresql://user:pass@staging-db:5432/hisabche