{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@hisabche/ui": ["../../packages/ui/src/index.ts"],
      "@hisabche/i18n": ["../../packages/i18n/src/index.ts"],
      "@hisabche/store": ["../../packages/store/src/index.ts"],
      "@hisabche/validation": ["../../packages/validation/src/index.ts"],
      "@hisabche/api": ["../../packages/api/src/index.ts"],
      "@hisabche/analytics": ["../../packages/analytics/src/index.ts"],
      "@hisabche/db": ["../../packages/db/src/index.ts"],
      "@hisabche/auth": ["../../packages/auth/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/ui/src/components/ui/invoice-detail/InvoicePDFDownload.tsx"],
  "exclude": ["node_modules"]
}