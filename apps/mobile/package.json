{
  "name": "@hisabche/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "e2e:android": "detox test --configuration android.emu.debug",
    "e2e:ios": "detox test --configuration ios.sim.debug"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@hisabche/api": "workspace:*",
    "@hisabche/auth-core": "workspace:*",
    "@hisabche/db": "workspace:*",
    "@hisabche/formatting": "workspace:*",
    "@hisabche/i18n": "workspace:*",
    "@hisabche/mobile-ui": "workspace:*",
    "@hisabche/store": "workspace:*",
    "@hisabche/ui-contract": "workspace:*",
    "@hisabche/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@react-native/assets-registry": "0.74.84",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@shopify/flash-list": "1.6.4",
    "@tanstack/react-query": "^5.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "expo": "~51.0.0",
    "expo-asset": "~10.0.10",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.9",
    "expo-haptics": "~13.0.1",
    "expo-linking": "~6.3.1",
    "expo-local-authentication": "~14.0.1",
    "expo-localization": "~15.0.3",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-status-bar": "~1.12.1",
    "i18next": "^23.11.5",
    "lucide-react": "^0.395.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.74.2",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "^0.19.13",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.2",
    "react": "18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.15",
    "detox": "^20.25.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/\\.pnpm/(?!((jest-)?react-native@|@react-native\\+|@react-native-community\\+|expo@|expo-|@expo\\+|@shopify\\+flash-list|react-navigation@|@react-navigation\\+|@hisabche\\+))",
      "node_modules/(?!\\.pnpm/)(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-modules-core|@shopify/flash-list|react-navigation|@react-navigation/.*|@hisabche/.*)/)"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/../../packages/mobile-ui/src"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1"
    }
  }
}
