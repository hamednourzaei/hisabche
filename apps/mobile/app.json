{
  "expo": {
    "name": "Hisabche",
    "slug": "hisabche",
    "scheme": "hisabche",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#059669",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hisabche.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "برای اسکن بارکد کالاها به دوربین نیاز است.",
        "NSFaceIDUsageDescription": "برای ورود امن به حساب خود."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#059669"
      },
      "package": "com.hisabche.mobile",
      "permissions": [
        "CAMERA",
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-camera",
      "expo-local-authentication",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://api.hisabche.com/api",
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
