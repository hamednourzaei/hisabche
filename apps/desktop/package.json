{
  "name": "@hisabche/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Hisabche accounting and inventory desktop app",
  "author": "Hisabche",
  "desktopName": "hisabche.desktop",
  "packageManager": "pnpm@11.9.0",
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "electron": "^31.7.7"
    }
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "jest",
    "e2e": "playwright test",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "clean": "rm -rf node_modules out dist",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@hisabche/api": "workspace:*",
    "@hisabche/app-bridge": "workspace:*",
    "@hisabche/app-shell": "workspace:*",
    "@hisabche/auth-core": "workspace:*",
    "@hisabche/formatting": "workspace:*",
    "@hisabche/i18n": "workspace:*",
    "@hisabche/store": "workspace:*",
    "@hisabche/ui": "workspace:*",
    "@hisabche/validation": "workspace:*",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/electron": "^7.16.0",
    "@tanstack/react-query": "^5.45.0",
    "@tanstack/react-virtual": "^3.8.3",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "electron-updater": "^6.3.4",
    "html2canvas": "^1.4.1",
    "i18next": "^23.11.5",
    "jalaali-js": "^1.2.8",
    "lucide-react": "^0.395.0",
    "moment-jalaali": "^0.10.4",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.51.0",
    "react-i18next": "^14.1.2",
    "react-phone-number-input": "^3.4.17",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@testing-library/react": "^16.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  }
}
