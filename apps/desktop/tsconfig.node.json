{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "electron"]
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"],
  "exclude": ["node_modules", "out", "dist"]
}
